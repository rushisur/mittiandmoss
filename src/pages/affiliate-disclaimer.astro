---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Affiliate Disclaimer — Mitti & Moss" description="Affiliate disclaimer for Mitti and Moss. Learn about our affiliate partnerships.">

  <section class="page-hero">
    <div class="container">
      <h1>Affiliate Disclaimer</h1>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow page-content">

      <p>Please assume that some of the links on Mitti and Moss are affiliate links. This means that if you click on one of these links and make a purchase, we may receive a small commission at <strong>no extra cost to you</strong>.</p>

      <p>Mitti and Moss participates in the <strong>Amazon Services LLC Associates Program</strong>, an affiliate advertising program designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.com and affiliated sites. As an Amazon Associate, we earn from qualifying purchases.</p>

      <p>We only recommend products and services that we believe will add value to our readers and align with the themes of biophilic, rustic, and minimalist home decor. Our goal is to provide helpful resources and inspiration, and any commissions earned help support the running of this blog.</p>

      <p>Your trust is important to us, and we strive to be transparent about our affiliations. If you have any questions regarding this, please feel free to <a href="/contact">contact us</a>.</p>

      <p>Thank you for your support!</p>

    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding: var(--space-3xl) 0 var(--space-xl);
    text-align: center;
    background: var(--color-warm-white);
    border-bottom: 1px solid var(--color-sand);
  }
  .page-hero h1 {
    font-size: clamp(2.5rem, 6vw, 3.8rem);
    font-weight: 400;
    margin-bottom: 0.5rem;
  }
  .page-content p {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }
  .page-content a {
    color: var(--color-earth);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-fast);
  }
  .page-content a:hover {
    border-color: var(--color-earth);
  }
</style>
