---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 7) // Get latest 7 posts
  .map(post => ({
    title: post.data.title,
    description: post.data.description,
    date: post.data.date.toISOString(),
    image: post.data.image,
    tags: post.data.tags,
    url: `/blog/${post.slug}`,
    featured: post.data.featured,
  }));

const categoryMeta = {
  "Japandi": "🏯", "Warm Neutrals": "🎨", "Biophilic Design": "🌿",
  "Living Room": "🛋️", "Bedroom Ideas": "🛏️", "Limewash Walls": "🖌️",
  "Styling Tips": "💡", "Natural Materials": "🪨", "Budget Decor": "💰",
  "Design Trends": "✨", "Seasonal Decor": "🎄",
};

const tagCounts = {};
allPosts.forEach(p => p.data.tags.forEach(t => { tagCounts[t] = (tagCounts[t] || 0) + 1; }));
const categories = Object.entries(tagCounts)
  .map(([name, count]) => ({ name, count, icon: categoryMeta[name] || "📁" }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 6);
---

<BaseLayout title="Mitti & Moss — Warm Neutral, Japandi & Minimalist Home Decor">

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__bg">
      <img
        src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=1600&q=80"
        alt="Elegant minimalist living room with warm neutral tones"
        loading="eager"
      />
      <!-- Gradient only at bottom to keep image clear -->
      <div class="hero__overlay"></div>
    </div>
    
    <div class="hero__content container">
      <div class="hero__text-box animate-in">
        <span class="hero__tag">Interior Design • Home Decor</span>
        <h1 class="hero__title">Where Design<br/>Meets Soul</h1>
        <p class="hero__subtitle">
          Warm neutrals, Japandi aesthetics & minimalist interiors —<br/> 
          curated to inspire a slower, more beautiful life.
        </p>
        <div class="hero__actions">
          <a href="/blog" class="btn btn--primary">Read the Journal</a>
          <a href="/about" class="btn btn--outline btn--light">Our Philosophy</a>
        </div>
      </div>
    </div>

    <div class="hero__scroll">
      <span>Scroll</span>
      <div class="hero__scroll-line"></div>
    </div>
  </section>

  <!-- Latest Posts -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="section-title text-left">
          <h2>Latest Stories</h2>
          <p>Fresh ideas for your home, curated with care</p>
        </div>
        <a href="/blog" class="btn btn--outline desktop-only">View All</a>
      </div>
      
      <div class="posts-grid">
        {posts.slice(0, 1).map(post => (
          <PostCard {...post} featured={true} />
        ))}
        {posts.slice(1, 4).map(post => (
          <PostCard {...post} />
        ))}
      </div>
      
      <div class="text-center mobile-only" style="margin-top: var(--space-lg);">
        <a href="/blog" class="btn btn--outline">View All Articles</a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="section categories-section">
    <div class="container">
      <div class="section-title">
        <h2>Browse by Category</h2>
        <p>Find exactly what inspires you</p>
      </div>
      <div class="categories-grid">
        {categories.map(cat => (
          <a href={`/categories/${cat.name.toLowerCase().replace(/\s+/g, '-')}`} class="category-card animate-on-scroll">
            <span class="category-card__icon">{cat.icon}</span>
            <h3 class="category-card__name">{cat.name}</h3>
            <span class="category-card__count">{cat.count} articles</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- More Posts -->
  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>More To Explore</h2>
      </div>
      <div class="posts-grid">
        {posts.slice(4).map(post => (
          <PostCard {...post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="section cta-section">
    <div class="container container--narrow">
      <div class="cta animate-on-scroll">
        <h2>Stay Inspired</h2>
        <p>Get our latest design ideas, styling tips, and home decor inspiration delivered straight to your inbox.</p>
        <form class="cta__form" action="#" method="post">
          <input type="email" placeholder="Your email address" required class="cta__input" />
          <button type="submit" class="btn btn--primary">Subscribe</button>
        </form>
        <span class="cta__note">No spam. Unsubscribe anytime.</span>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    height: 95vh; /* Taller for impact */
    display: flex;
    align-items: flex-end; /* Align bottom */
    justify-content: flex-start; /* Align left */
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    /* Gradient starts from bottom to up - keeping top clear */
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.4) 40%,
      rgba(0, 0, 0, 0) 70%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-bottom: var(--space-3xl); /* Lift up from very bottom */
  }

  /* Box constraint for text so it doesn't span full width */
  .hero__text-box {
    max-width: 650px;
    margin-left: 0; 
  }

  .hero__tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
    margin-bottom: var(--space-sm);
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(4px);
    padding: 0.4rem 1rem;
    border-radius: 50px;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8vw, 5.5rem); /* Bigger */
    font-weight: 400;
    line-height: 1.1;
    color: white;
    margin-bottom: var(--space-md);
    text-shadow: 0 4px 20px rgba(0,0,0,0.2);
  }

  .hero__subtitle {
    font-size: 1.15rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.9);
    max-width: 520px;
    margin-bottom: var(--space-lg);
    font-weight: 300;
    text-shadow: 0 2px 10px rgba(0,0,0,0.2);
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn--light {
    color: white;
    border-color: rgba(255,255,255,0.6);
  }
  .btn--light:hover {
    background: white;
    color: var(--color-charcoal);
  }

  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    right: 3rem; /* Moved to right */
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    animation: fadeIn 1s ease 1s forwards;
    opacity: 0;
  }
  
  .hero__scroll span {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    writing-mode: vertical-rl; /* Vertical text */
  }

  .hero__scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.6), transparent);
  }

  /* Animations using simple CSS keyframes for load */
  .animate-in {
    animation: fadeInUp 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    opacity: 0;
    transform: translateY(30px);
  }

  /* Section Header Flex */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-lg);
  }
  
  .section-title.text-left {
    text-align: left;
    margin: 0;
  }

  /* ---------- Posts Grid ---------- */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  /* ---------- Categories ---------- */
  .categories-section {
    background: var(--color-warm-white);
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-lg) var(--space-md);
    background: white;
    border-radius: 12px;
    text-align: center;
    transition: all var(--transition-smooth);
    box-shadow: var(--shadow-soft);
    border: 1px solid transparent;
  }

  .category-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-medium);
    border-color: var(--color-sand);
  }

  .category-card__icon {
    font-size: 2rem;
    margin-bottom: 0.8rem;
  }

  .category-card__name {
    font-size: 1.2rem;
    margin-bottom: 0.3rem;
  }

  .category-card__count {
    font-size: 0.75rem;
    color: var(--color-warm-gray);
    letter-spacing: 0.05em;
  }

  /* ---------- CTA Section ---------- */
  .cta-section {
    background: var(--color-warm-white);
  }

  .cta {
    text-align: center;
    padding: var(--space-2xl);
    background: white;
    border-radius: 20px; /* Softer */
    box-shadow: var(--shadow-soft);
  }

  .cta h2 {
    margin-bottom: var(--space-sm);
  }

  .cta p {
    color: var(--color-warm-gray);
    max-width: 440px;
    margin: 0 auto var(--space-lg);
    font-size: 1.05rem;
  }

  .cta__form {
    display: flex;
    gap: 0.8rem;
    max-width: 460px;
    margin: 0 auto var(--space-sm);
  }

  .cta__input {
    flex: 1;
    padding: 0.9rem 1.4rem;
    border: 1px solid var(--color-sand);
    border-radius: 50px; /* Pill input */
    font-family: var(--font-body);
    font-size: 0.95rem;
    background: var(--color-cream);
    transition: border-color var(--transition-fast);
  }

  .cta__input:focus {
    outline: none;
    border-color: var(--color-earth);
  }

  .cta__note {
    font-size: 0.75rem;
    color: var(--color-warm-gray);
  }
  
  .desktop-only { display: inline-flex; }
  .mobile-only { display: none; }

  /* ---------- Responsive ---------- */
  @media (max-width: 1024px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
    .categories-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .hero { min-height: 80vh; align-items: center; justify-content: center; text-align: center; }
    .hero__text-box { margin: 0 auto; padding: 0 var(--space-md); }
    .hero__scroll { display: none; }
    .hero__overlay { background: rgba(0,0,0,0.4); } /* Darker overall for mobile legibility */
    
    .posts-grid { grid-template-columns: 1fr; }
    .categories-grid { grid-template-columns: repeat(2, 1fr); }
    
    .desktop-only { display: none; }
    .mobile-only { display: block; }
    
    .cta { padding: var(--space-xl) var(--space-md); }
    .cta__form { flex-direction: column; }
    .cta__input, .cta__form button { width: 100%; border-radius: 8px; } /* Reset pill for stacked */
  }

  @media (max-width: 480px) {
    .categories-grid { grid-template-columns: 1fr; }
    .hero__title { font-size: 2.5rem; }
  }
</style>
